# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (mongodb:// or mongodb+srv://)
MONGODB_URI=
# Fixed by the app; kept here so the shape of the config is complete
MONGODB_DB=kiana-khorsand

# ── Authentication ──────────────────────────────────────────────────────────
# 32+ random characters — `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# The URL the auth server answers on (local dev or the deployed origin)
BETTER_AUTH_URL=http://localhost:3000
# Optional: dedicated key that encrypts private meeting notes (HKDF → AES-256-GCM)
PRIVATE_NOTES_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical origin. Ignored on Vercel, where the deployment's own domain wins.
SITE_URL=http://localhost:3000
# Optional extra trusted origin (for example a tunnel or a preview URL)
AUTH_PREVIEW_ORIGIN=

# ── Seed accounts (`npm run seed`) ──────────────────────────────────────────
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PHONE=
SEED_CLIENT_PASSWORD=
