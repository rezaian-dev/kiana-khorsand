# Copy to .env.local and fill — never commit .env.local
MONGODB_URI=mongodb://127.0.0.1:27017/kiana-khorsand
MONGODB_DB=kiana-khorsand
BETTER_AUTH_SECRET=replace-with-48-random-chars-min-32
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Optional preview origin for Vercel previews
AUTH_PREVIEW_ORIGIN=
# Seed demo (requires SEED_ALLOW_DEMO=1 + localhost URI)
SEED_ALLOW_DEMO=0
SEED_DEMO_PASSWORD=
SEED_ADMIN_PHONE=09xxxxxxxxx
SEED_ADMIN_PASSWORD=your-admin-password-min-16
SEED_CLIENT_PHONE=09xxxxxxxxx
SEED_CLIENT_PASSWORD=your-client-password-min-8
# Private notes encryption (independent of BETTER_AUTH_SECRET per F10)
PRIVATE_NOTES_KEY=replace-with-32-random-chars-min-32
